DB_NAME=simple_recipe_website
DB_USER=django
DB_PASSWORD=unsecure-please-change-this
DB_ADMIN_PASSWORD=unsecure-please-change-this-too

# localhost is correct for development, where Django runs on the host and
# reaches the database through the port compose publishes. The app container
# overrides this to the `db` service name; nothing here needs changing to run
# either mode.
DB_HOST=localhost
DB_PORT=5432

# Where the whole site is published in production mode: the web container's
# port, and the only one a browser needs. Development uses Vite's 5173 instead,
# and the app container publishes nothing — everything reaches it through the
# web server.
WEB_PORT=8080

DJANGO_SECRET_KEY=dev-only-change-me

# Development only. compose.yaml forces this off for the app container, so
# leaving it true here cannot leak debug pages out of a running deployment.
DJANGO_DEBUG=true

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
