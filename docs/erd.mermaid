  varchar password 
  timestamp_with_time_zone last_login 
  boolean is_superuser 
  varchar username 
  varchar first_name 
  varchar last_name 
  varchar email 
  boolean is_staff 
  boolean is_active 
  timestamp_with_time_zone date_joined 
}
