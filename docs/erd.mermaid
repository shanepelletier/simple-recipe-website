  varchar name 
  varchar plural 
  varchar normalized_name 
}
Recipe {
  bigint id pk
  bigint owner_id 
  varchar name 
  varchar photo 
  integer rating_sum 
  integer rating_count 
  integer version 
  bigint copied_from_id 
  varchar copied_from_username 
  timestamp_with_time_zone created_at 
  timestamp_with_time_zone updated_at 
}
RecipeIngredient {
  bigint id pk
  bigint recipe_id 
  bigint ingredient_id 
  bigint unit_id 
  numeric quantity 
  smallint position 
}
Step {
  bigint id pk
  bigint recipe_id 
  text text 
  smallint position 
}
Review {
  bigint id pk
  bigint recipe_id 
  bigint user_id 
  smallint rating 
  timestamp_with_time_zone created_at 
}
Comment {
  bigint id pk
  bigint recipe_id 
  bigint author_id 
  text body 
  varchar photo 
  timestamp_with_time_zone created_at 
}
ShoppingItem {
  bigint id pk
  bigint user_id 
  bigint ingredient_id 
  bigint unit_id 
  numeric quantity 
  boolean is_checked 
  bigint source_recipe_id 
  timestamp_with_time_zone created_at 
}
