#!/bin/sh
# Blocks the commit if the code being committed fails its checks: ruff
# lint/format, mypy, and the test suite for the Django project; oxfmt for the
# client.
#
# Activate once per clone with:
#   git config core.hooksPath .githooks

set -e

root="$(git rev-parse --show-toplevel)"
staged="$(git diff --cached --name-only)"

# Each half of the repo is checked only when that half is actually being
# committed. The Python suite is about a minute, which is a long time to be
# told that a stylesheet is fine. Deletions are deliberately not filtered out
# of `staged` — removing a module is exactly the kind of change that breaks
# the suite.
#
# Commit with PRECOMMIT_ALL=1 to run everything regardless of what is staged.
staged_in() {
  if [ -n "$PRECOMMIT_ALL" ]; then
    return 0
  fi
  printf '%s\n' "$staged" | grep -q "^$1/"
}

if staged_in server; then
  cd "$root/server"
  uv run ruff check .
  uv run ruff format --check .
  # The django-stubs mypy plugin and pytest-django both initialize real
  # Django settings, so they need the same env vars the app runs with.
  uv run --env-file ../.env mypy config
  uv run --env-file ../.env pytest
else
  echo "pre-commit: nothing staged under server/, skipping the Python checks"
fi

if staged_in client; then
  cd "$root/client"

  # Skipped when dependencies aren't installed, so the hook never fails for a
  # reason the committer can do nothing about — a fresh clone that hasn't run
  # `npm install` yet, most obviously.
  if [ -d node_modules ]; then
    npm run format:check
  else
    echo "pre-commit: skipping client checks (run 'npm install' in client/ first)"
  fi
else
  echo "pre-commit: nothing staged under client/, skipping the client checks"
fi
