#!/bin/sh
# Blocks the commit if the Django project fails ruff lint/format or mypy.
#
# Activate once per clone with:
#   git config core.hooksPath .githooks

set -e

cd "$(git rev-parse --show-toplevel)/server"

uv run ruff check .
uv run ruff format --check .
# The django-stubs mypy plugin initializes real Django settings to
# introspect models, so it needs the same env vars the app runs with.
uv run --env-file ../.env mypy config
